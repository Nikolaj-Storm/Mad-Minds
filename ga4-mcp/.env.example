# Google Analytics (GA4) marketer MCP — per-user Google OAuth (analytics.readonly).
# In Mad-Minds these come from each marketer's Google sign-in; for a standalone /
# Claude Desktop run, fill them here (or in the MCP server's env block).
GA4_OAUTH_CLIENT_ID=replace_me.apps.googleusercontent.com
GA4_OAUTH_CLIENT_SECRET=replace_me
GA4_OAUTH_REFRESH_TOKEN=replace_me
# GA4_PROPERTY_ID=123456789   # optional single-property default (else pass property_id per call)
